# Multi-Source AI Research Engine Configuration

# Application
PROJECT_NAME="Multi-Source AI Research Engine"
API_V1_STR="/api"
DATABASE_URL="sqlite:///./research_engine.db"

# Pipeline Parameters
REQUEST_TIMEOUT_SECONDS=12.0
MAX_CONCURRENT_REQUESTS=5
DEFAULT_RESULT_LIMIT=15

# Optional Credentials (Sources function in public/free modes when not provided)
GITHUB_TOKEN=
STACKEXCHANGE_KEY=

# Reddit OAuth Credentials (Required only if Reddit connector is desired)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=python:multi-source-research-engine:v1.0.0 (by /u/app_developer)

# Kaggle API Credentials (Optional - obtained from kaggle.com/settings -> Create New Token)
KAGGLE_USERNAME=
KAGGLE_KEY=

# OpenAlex (Optional API key or email for polite pool elevated rate limits)
OPENALEX_API_KEY=
OPENALEX_EMAIL=researcher@example.com

# Crossref (Polite pool contact email for header)
CROSSREF_MAILTO=researcher@example.com

# AI Discovery Provider Configuration (Agnes AI as primary)
AGNES_API_KEY=
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
AGNES_MODEL=agnes-2.5-flash

# Optional OpenAI Provider (Secondary fallback)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

